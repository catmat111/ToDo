<!DOCTYPE html>
<html lang="pt" data-theme="<%= theme_attribute %>">
  <head>
    <title><%= [content_for(:title), "Tu Do"].compact.join(" · ") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="color-scheme" content="<%= { "light" => "light", "dark" => "dark" }.fetch(theme_attribute, "light dark") %>">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Tu Do">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/tudo-favicon.png" type="image/png">
    <link rel="apple-touch-icon" href="/tudo-apple-touch-icon.png">
    <%# Installable app (PWA): manifest + charcoal title bar like the masthead. %>
    <%= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>
    <meta name="theme-color" content="#382C23">
    <meta name="apple-mobile-web-app-title" content="Tu Do">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;1,500;1,600&family=Instrument+Sans:wght@400;500;600&display=swap">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <a class="skip-link" href="#main">Saltar para o conteúdo</a>
    <%# Turbo swaps <body> but not <html>; this keeps data-theme in sync after Turbo visits. %>
    <div data-controller="theme" data-theme-name-value="<%= theme_attribute %>" hidden></div>
    <% if authenticated? %>
      <%# Live notifications: new ones pop up, update the counter and the notifications page. %>
      <%= turbo_stream_from Current.user, :notifications %>
      <div id="toasts" class="toasts" aria-live="polite"></div>

      <header class="masthead">
        <div class="masthead__inner">
          <%= link_to root_path, class: "wordmark", "aria-label": "Tu Do. — início" do %>Tu Do<span class="wordmark__dot">.</span><% end %>
          <nav class="mainnav" aria-label="Principal">
            <% main_sections.each do |section| %>
              <%= link_to section[:label], section[:path], class: [ "mainnav__link", ("is-active" if section[:active]) ],
                    "aria-current": (section[:active] ? "page" : nil) %>
            <% end %>
          </nav>
          <div class="masthead__tools" data-controller="search-shortcut" data-action="keydown@window->search-shortcut#focus">
            <%= form_with url: search_path, method: :get, class: "masthead__search", role: "search" do |f| %>
              <%= icon :search, size: 16 %>
              <%= f.search_field :q, value: (params[:q] if controller_name == "searches"), placeholder: "Pesquisar…",
                    "aria-label": "Pesquisar em tudo", data: { search_shortcut_target: "input" } %>
              <kbd class="masthead__search-key" aria-hidden="true">/</kbd>
            <% end %>
            <%= link_to notifications_path, class: "masthead__icon", title: "Notificações" do %>
              <%= icon :bell, title: "Notificações" %>
              <%= render "notifications/badge", count: unread_notifications_count %>
            <% end %>
            <%= theme_toggle_button %>
            <%= link_to profile_path, class: "masthead__avatar", title: Current.user.name do %>
              <%= user_avatar(Current.user) %>
            <% end %>
          </div>
        </div>
        <% if (links = section_links).any? %>
          <nav class="subnav" aria-label="Secção">
            <% links.each do |item| %>
              <% if item[:method] %>
                <%= button_to item[:label], item[:path], method: item[:method], class: "subnav__link subnav__link--button",
                      form: { data: { turbo_confirm: item[:confirm] } } %>
              <% else %>
                <%= link_to item[:path], class: [ "subnav__link", ("is-active" if item[:active]) ] do %>
                  <%= item[:label] %><% if item[:badge].to_i.positive? %> <span class="subnav__count"><%= item[:badge] %></span><% end %>
                <% end %>
              <% end %>
            <% end %>
          </nav>
        <% end %>
      </header>

      <main id="main" class="content">
        <%= render "shared/flash" %>
        <%= yield %>
      </main>
      <%= render "shared/quickadd" %>
    <% else %>
      <main id="main" class="auth">
        <div class="auth__panel">
          <div class="auth__brand">
            <%= image_tag "tu-do-logo.png", class: "auth__logo", alt: "Tu Do. Studio", width: 180, height: 195 %>
            <p class="auth__tagline">Tarefas, candidaturas e o teu tempo, num só sítio.</p>
          </div>
          <%= render "shared/flash" %>
          <%= yield %>
        </div>
      </main>
    <% end %>
  </body>
</html>
