<% content_for :title, "Adicionar vaga" %>

<nav class="breadcrumb" aria-label="Navegação estrutural">
  <%= link_to "Vagas", job_listings_path %> / <span aria-current="page">Adicionar</span>
</nav>

<div class="page-header">
  <div>
    <h1 class="page-header__title">Adicionar vaga</h1>
    <p class="page-header__subtitle">Cola o link da vaga que encontraste. Se já estiver guardada, levamos-te até ela.</p>
  </div>
</div>

<div class="card job-listing-form-card">
  <%= form_with model: @job_listing, class: "form" do |f| %>
    <%= render "shared/form_errors", record: @job_listing %>

    <div class="field">
      <%= f.label :url, "Link da vaga", class: "field__label" %>
      <%= f.url_field :url, required: true, autofocus: true, placeholder: "https://www.linkedin.com/jobs/view/…",
            "aria-describedby": "job_listing_url_hint" %>
      <p class="field__hint" id="job_listing_url_hint">Parâmetros de tracking (utm_…, trk…) são ignorados para detetar duplicados.</p>
    </div>

    <div class="field">
      <%= f.label :title, "Título", class: "field__label" %>
      <%= f.text_field :title, required: true, maxlength: 200, placeholder: "Ex.: Desenvolvedor(a) Ruby on Rails" %>
    </div>

    <div class="form__row">
      <div class="field">
        <%= f.label :company_name, "Empresa", class: "field__label" %>
        <%= f.text_field :company_name, maxlength: 200 %>
      </div>
      <div class="field">
        <%= f.label :location, "Localização", class: "field__label" %>
        <%= f.text_field :location, maxlength: 200, placeholder: "Ex.: Lisboa · Híbrido" %>
      </div>
    </div>

    <div class="form__row">
      <div class="field">
        <%= f.label :source, "Fonte", class: "field__label" %>
        <%= f.select :source, [ [ "Detetar pelo link", "" ] ] + job_source_options, { selected: @selected_source.to_s } %>
      </div>
      <div class="field">
        <%= f.label :job_search_id, "Pesquisa", class: "field__label" %>
        <%= f.select :job_search_id, @job_searches.map { |search| [ search.name, search.id ] }, { include_blank: "Nenhuma" } %>
      </div>
      <div class="field">
        <%= f.label :published_at, "Publicada em", class: "field__label" %>
        <%= f.datetime_field :published_at %>
      </div>
    </div>

    <div class="field">
      <%= f.label :external_id, "ID externo", class: "field__label" %>
      <%= f.text_field :external_id, maxlength: 200, "aria-describedby": "job_listing_external_id_hint" %>
      <p class="field__hint" id="job_listing_external_id_hint">Opcional. Nos links do LinkedIn e do Indeed é preenchido automaticamente.</p>
    </div>

    <div class="field">
      <%= f.label :description, "Descrição", class: "field__label" %>
      <%= f.text_area :description, rows: 8, placeholder: "Cola aqui o texto do anúncio (opcional)" %>
    </div>

    <div class="form__actions">
      <%= f.submit "Guardar vaga", class: "btn btn--primary" %>
      <%= link_to "Cancelar", @job_listing.job_search ? job_search_path(@job_listing.job_search) : job_listings_path, class: "btn btn--ghost" %>
    </div>
  <% end %>
</div>
