<% content_for :title, @job_search.name %>
<% adapter = JobSearches::Sources.for(@job_search) %>
<% search_url = adapter.url %>
<% unsupported = @job_search.unsupported_filters %>

<nav class="breadcrumb" aria-label="Navegação estrutural">
  <%= link_to "Pesquisas", job_searches_path %> / <span aria-current="page"><%= @job_search.name %></span>
</nav>

<div class="page-header">
  <div>
    <h1 class="page-header__title"><%= @job_search.name %></h1>
    <p class="page-header__subtitle cluster">
      <%= job_source_badge(@job_search.source) %>
      <%= job_search_state_badge(@job_search) %>
      <span><%= job_last_run(@job_search) %></span>
    </p>
  </div>
  <div class="page-header__actions">
    <%= run_job_search_button(@job_search, css: "btn btn--primary") %>
    <%= link_to edit_job_search_path(@job_search), class: "btn btn--outline" do %><%= icon :edit %> Editar<% end %>
    <%= button_to job_search_path(@job_search), method: :delete, class: "btn btn--danger",
          form: { data: { turbo_confirm: "Eliminar a pesquisa «#{@job_search.name}»? As vagas encontradas continuam guardadas." } } do %>
      <%= icon :trash %> Eliminar
    <% end %>
  </div>
</div>

<div class="grid grid--sidebar">
  <div class="stack--lg">
    <section class="card" id="filtros" aria-labelledby="filters-title">
      <div class="card__header">
        <div>
          <h2 class="card__title" id="filters-title">Filtros</h2>
          <p class="small muted job-search-section-hint">Aplicados automaticamente quando abres a pesquisa no <%= adapter.label %>.</p>
        </div>
        <span class="badge"><%= @job_filters.size %></span>
      </div>

      <% if unsupported.any? %>
        <p class="job-search-warning" role="status">
          <%= icon :clock, size: 16 %>
          <%= unsupported.map(&:label).uniq.to_sentence(last_word_connector: " e ", two_words_connector: " e ") %>
          <%= unsupported.size == 1 ? "não é suportado" : "não são suportados" %> pela fonte <%= @job_search.source_label %> e
          <%= unsupported.size == 1 ? "é ignorado" : "são ignorados" %> no link gerado.
        </p>
      <% end %>

      <% if @job_filters.any? %>
        <ul class="list job-filter-list">
          <% @job_filters.each do |filter| %>
            <% editing = @editing_filter&.id == filter.id ? @editing_filter : filter %>
            <li class="list__item job-filter-list__item">
              <div class="list__main">
                <div class="job-filter-list__summary">
                  <span class="job-filter-list__key"><%= filter.label %></span>
                  <span class="badge badge--type"><%= filter.operator_label %></span>
                  <span class="job-filter-list__value"><%= filter.value_label %></span>
                  <% unless filter.supported_by_source? %>
                    <span class="badge badge--archived">Ignorado</span>
                  <% end %>
                </div>

                <details class="job-filter-edit" <%= "open" if editing.errors.any? %>>
                  <summary class="small">Editar</summary>
                  <%= form_with model: editing, url: job_search_job_filter_path(@job_search, filter), method: :patch,
                        class: "form job-filter-form", data: { controller: "job-filter-form",
                        job_filter_form_prefix_value: job_filter_datalist_prefix(@job_search),
                        job_filter_form_free_text_value: JobFilter::FREE_TEXT_KEYS.to_json } do |f| %>
                    <%= render "shared/form_errors", record: editing %>
                    <div class="form__row">
                      <div class="field">
                        <%= f.label :key, "Filtro", for: "job_filter_#{filter.id}_key", class: "field__label" %>
                        <%= f.select :key, job_filter_key_options(@job_search) | [ [ filter.label, filter.key ] ], {},
                              id: "job_filter_#{filter.id}_key", data: { job_filter_form_target: "key", action: "job-filter-form#update" } %>
                      </div>
                      <div class="field">
                        <%= f.label :operator, "Operador", for: "job_filter_#{filter.id}_operator", class: "field__label" %>
                        <%= f.select :operator, job_filter_operator_options, {},
                              id: "job_filter_#{filter.id}_operator", data: { job_filter_form_target: "operator" } %>
                      </div>
                      <div class="field">
                        <%= f.label :value, "Valor", for: "job_filter_#{filter.id}_value", class: "field__label" %>
                        <%= f.text_field :value, id: "job_filter_#{filter.id}_value", required: true, maxlength: 200,
                              value: editing.value, list: job_filter_datalist_id(@job_search, editing.key), autocomplete: "off",
                              data: { job_filter_form_target: "value" } %>
                      </div>
                    </div>
                    <div class="form__actions">
                      <%= f.submit "Guardar filtro", class: "btn btn--secondary btn--sm" %>
                    </div>
                  <% end %>
                </details>
              </div>
              <div class="list__actions">
                <%= button_to job_search_job_filter_path(@job_search, filter), method: :delete, class: "btn btn--ghost btn--icon",
                      title: "Remover filtro", form: { data: { turbo_confirm: "Remover o filtro «#{filter.label}: #{filter.value_label}»?" } } do %>
                  <%= icon :trash, title: "Remover filtro #{filter.label}" %>
                <% end %>
              </div>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="muted">Ainda não há filtros. Sem filtros, a pesquisa usa apenas os termos de pesquisa.</p>
      <% end %>

      <div class="card__footer">
        <h3 class="job-search-subtitle">Adicionar filtro</h3>
        <% default_key = @job_filter.key.presence || @job_search.allowed_filter_keys.first %>
        <%= form_with model: @job_filter, url: job_search_job_filters_path(@job_search), method: :post,
              class: "form job-filter-form", data: { controller: "job-filter-form",
              job_filter_form_prefix_value: job_filter_datalist_prefix(@job_search),
              job_filter_form_free_text_value: JobFilter::FREE_TEXT_KEYS.to_json } do |f| %>
          <%= render "shared/form_errors", record: @job_filter %>
          <div class="form__row">
            <div class="field">
              <%= f.label :key, "Filtro", class: "field__label" %>
              <%= f.select :key, job_filter_key_options(@job_search), { selected: default_key },
                    data: { job_filter_form_target: "key", action: "job-filter-form#update" } %>
            </div>
            <div class="field">
              <%= f.label :operator, "Operador", class: "field__label" %>
              <%= f.select :operator, job_filter_operator_options, {}, data: { job_filter_form_target: "operator" },
                    "aria-describedby": "job_filter_operator_hint" %>
            </div>
            <div class="field">
              <%= f.label :value, "Valor", class: "field__label" %>
              <%= f.text_field :value, required: true, maxlength: 200, autocomplete: "off",
                    list: job_filter_datalist_id(@job_search, default_key), placeholder: "Escolhe ou escreve um valor",
                    data: { job_filter_form_target: "value" } %>
            </div>
          </div>
          <p class="field__hint" id="job_filter_operator_hint" data-job-filter-form-target="hint">
            «Exclui» transforma o valor num termo NOT (ex.: NOT estágio). Localização e palavras-chave aceitam todos os operadores; os restantes filtros usam «Igual».
          </p>
          <div class="form__actions">
            <%= f.button type: :submit, class: "btn btn--secondary" do %><%= icon :plus %> Adicionar filtro<% end %>
          </div>
        <% end %>

        <% JobFilter::KEY_LABELS.each_key do |key| %>
          <datalist id="<%= job_filter_datalist_id(@job_search, key) %>">
            <% JobFilter.suggestions_for(key).each do |value, label| %>
              <option value="<%= value %>"><%= label %></option>
            <% end %>
          </datalist>
        <% end %>
      </div>
    </section>

    <section class="card" id="vagas" aria-labelledby="listings-title">
      <div class="card__header">
        <h2 class="card__title" id="listings-title">Vagas encontradas</h2>
        <%= link_to new_job_listing_path(job_search_id: @job_search.id), class: "btn btn--secondary btn--sm" do %>
          <%= icon :plus %> Adicionar vaga encontrada
        <% end %>
      </div>

      <% if @job_listings.any? %>
        <ul class="list job-listing-compact">
          <% @job_listings.each do |listing| %>
            <li class="list__item">
              <div class="list__main">
                <%= link_to listing.title, listing, class: "list__title" %>
                <div class="list__meta">
                  <% if (subtitle = job_listing_subtitle(listing)).present? %><span><%= subtitle %></span><% end %>
                  <span><%= job_listing_discovered(listing) %></span>
                </div>
              </div>
              <div class="list__actions">
                <%= link_to listing.url, class: "btn btn--ghost btn--icon", target: "_blank", rel: "noopener noreferrer", title: "Abrir vaga" do %>
                  <%= icon :external, title: "Abrir vaga #{listing.title} (novo separador)" %>
                <% end %>
              </div>
            </li>
          <% end %>
        </ul>
        <% total = @job_search.job_listings.count %>
        <% if total > @job_listings.size %>
          <p class="small job-search-more"><%= link_to "Ver todas as #{total} vagas", job_listings_path(job_search_id: @job_search.id) %></p>
        <% end %>
      <% else %>
        <%= render "shared/empty_state",
              title: "Nenhuma vaga guardada",
              body: "Quando encontrares uma vaga interessante nesta pesquisa, guarda-a aqui para não a perderes e transformá-la numa candidatura." %>
      <% end %>
    </section>
  </div>

  <aside class="stack">
    <section class="card card--olive" aria-labelledby="details-title">
      <h2 class="card__title job-search-aside-title" id="details-title">Pesquisa</h2>
      <dl class="dl">
        <dt>Fonte</dt>
        <dd><%= @job_search.source_label %></dd>
        <dt>Termos</dt>
        <dd><%= @job_search.query.presence || "—" %></dd>
        <dt>Estado</dt>
        <dd><%= @job_search.active? ? "Ativa" : "Em pausa" %></dd>
        <dt>Aberta</dt>
        <dd><%= @job_search.last_run_at ? format_datetime(@job_search.last_run_at) : "Nunca" %></dd>
        <dt>Criada</dt>
        <dd><%= format_date(@job_search.created_at) %></dd>
      </dl>
    </section>

    <section class="card" aria-labelledby="url-title" data-controller="job-search-url">
      <h2 class="card__title job-search-aside-title" id="url-title">Link gerado</h2>
      <p class="small muted">Pré-visualização do endereço que vai ser aberto no <%= adapter.label %>.</p>
      <code class="job-search-url" title="<%= search_url %>" data-job-search-url-target="source"><%= truncate(search_url, length: 160) %></code>
      <div class="cluster job-search-url__actions">
        <button type="button" class="btn btn--outline btn--sm" data-action="job-search-url#copy"
                data-job-search-url-url-param="<%= search_url %>">
          <%= icon :link %> <span data-job-search-url-target="label">Copiar link</span>
        </button>
        <%= run_job_search_button(@job_search, label: "Abrir", css: "btn btn--ghost btn--sm") %>
      </div>
      <p class="sr-only" role="status" aria-live="polite" data-job-search-url-target="status"></p>
    </section>
  </aside>
</div>
