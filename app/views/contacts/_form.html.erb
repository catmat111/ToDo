<%# locals: (contact:) %>
<%= form_with model: contact, class: "form" do |f| %>
  <%= render "shared/form_errors", record: contact %>
  <div class="form__row">
    <div class="field">
      <%= f.label :name, "Nome" %>
      <%= f.text_field :name, required: true, maxlength: 200, autofocus: contact.new_record? %>
    </div>
    <div class="field">
      <%= f.label :role, "Cargo" %>
      <%= f.text_field :role, placeholder: "Ex.: Recrutadora, Tech Lead" %>
    </div>
  </div>
  <div class="field">
    <%= f.label :company_id, "Empresa" %>
    <%= f.collection_select :company_id, Current.user.companies.alphabetical, :id, :name, include_blank: "— Sem empresa —" %>
  </div>
  <div class="form__row">
    <div class="field">
      <%= f.label :email, "Email" %>
      <%= f.email_field :email %>
    </div>
    <div class="field">
      <%= f.label :phone, "Telefone" %>
      <%= f.telephone_field :phone %>
    </div>
  </div>
  <div class="field">
    <%= f.label :linkedin_url, "LinkedIn" %>
    <%= f.url_field :linkedin_url, placeholder: "https://www.linkedin.com/in/…" %>
  </div>
  <div class="field">
    <%= f.label :notes, "Notas" %>
    <%= f.text_area :notes, rows: 4, placeholder: "Como se conheceram, o que falaram, próximos passos…" %>
  </div>
  <div class="form__actions">
    <%= f.button type: "submit", class: "btn btn--primary" do %><%= icon :check %> Guardar<% end %>
    <%= link_to "Cancelar", contact.company || contacts_path, class: "btn btn--ghost" %>
    <% if contact.persisted? %>
      <%= link_to "Eliminar", contact_path(contact), class: "btn btn--danger",
            data: { turbo_method: :delete, turbo_confirm: "Eliminar este contacto?" } %>
    <% end %>
  </div>
<% end %>
