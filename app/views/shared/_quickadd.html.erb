<%# Floating "post-it" button (bottom-right) that opens a small chat: on a task page it
    changes that task (Tasks::Chat, then the local LLM); everywhere else it adds tasks and
    events (the local LLM, or QuickAdd's rules). It stays put across pages and refreshes
    (data-turbo-permanent): the task chat has its own id, so it swaps on task pages. %>
<% chat_task = @task if controller_name == "tasks" && action_name == "show" && @task&.persisted? %>
<% llm = OllamaClient.enabled? %>
<% suggestions = chat_task ? Tasks::Chat::EXAMPLES.first(5) :
     [ "Ligar ao banco amanhã às 10h", "Entregar relatório sexta", "Jantar com a Ana sábado às 20h" ] %>
<div class="quickadd" id="<%= chat_task ? "quickadd-task-#{chat_task.id}" : "quickadd" %>" data-turbo-permanent
     data-controller="quickadd" data-action="keydown.esc@window->quickadd#close">
  <section class="quickadd__panel" id="quickadd-panel" role="dialog" aria-modal="false"
           aria-labelledby="quickadd-title" data-quickadd-target="panel" hidden>
    <header class="quickadd__header">
      <span class="quickadd__badge" aria-hidden="true"><%= icon(chat_task ? :tasks : :plus, size: 16) %></span>
      <div class="quickadd__heading">
        <p class="quickadd__title" id="quickadd-title"><%= chat_task ? "Nesta tarefa" : "O que tens para fazer?" %></p>
        <p class="quickadd__subtitle">
          <% if chat_task %><%= chat_task.title.truncate(40) %><% else %>Tarefas e eventos<% end %>
          <% if llm %><span class="quickadd__ai" title="Pedidos em texto livre, percebidos por uma IA que corre neste computador (Ollama)">· IA local</span><% end %>
        </p>
      </div>
      <button type="button" class="quickadd__close" data-action="quickadd#close" aria-label="Fechar"><%= icon :x, size: 18 %></button>
    </header>

    <div class="quickadd__messages" id="quickadd_messages" data-quickadd-target="messages" aria-live="polite">
      <div class="quickadd__msg quickadd__msg--app">
        <% if chat_task %>
          Diz-me o que mudar nesta tarefa<%= " — por palavras tuas" if llm %>.
        <% else %>
          Olá<%= ", #{Current.user.first_name}" if Current.user.first_name %>! Escreve o que tens de fazer e quando.
          <%= llm ? "Podes pôr várias coisas na mesma frase." : "Sem data, fica para hoje." %>
        <% end %>
      </div>
    </div>

    <div class="quickadd__suggestions" aria-label="Sugestões">
      <% suggestions.each do |example| %>
        <button type="button" class="quickadd__example" data-action="quickadd#fill" data-quickadd-text-param="<%= example %>"><%= example %></button>
      <% end %>
    </div>

    <%= form_with url: (chat_task ? task_chat_path(chat_task) : quick_add_path), class: "quickadd__form",
          data: { action: "turbo:submit-end->quickadd#sent" } do |f| %>
      <%= f.label :message, (chat_task ? "Pedido para esta tarefa" : "Nova tarefa ou evento"), class: "sr-only", for: "quickadd-input" %>
      <%= f.text_field :message, id: "quickadd-input", required: true, autocomplete: "off",
            maxlength: (chat_task ? 1000 : 500), data: { quickadd_target: "input" },
            placeholder: (chat_task ? "Ex.: lembra-me na véspera às 9h" : "Ex.: ligar ao banco amanhã às 10h") %>
      <button type="submit" class="quickadd__send" aria-label="Enviar"><%= icon :send, size: 16 %></button>
    <% end %>
  </section>

  <button type="button" class="quickadd__fab" data-action="quickadd#toggle" data-quickadd-target="toggle"
          aria-controls="quickadd-panel" aria-expanded="false" title="<%= chat_task ? "Mudar esta tarefa pelo chat" : "Adicionar tarefa ou evento" %>">
    <svg viewBox="-2 -4 70 70" width="96" height="96" aria-hidden="true">
      <path d="M8 10h48v40H8z" fill="#FBF3DC" stroke="#382C23" stroke-width="3.5" stroke-linejoin="round"/>
      <path d="M4 50h38c0 6 4 8 8 8H10c-3 0-6-3-6-8z" fill="#E9C46A" stroke="#382C23" stroke-width="3.5" stroke-linejoin="round"/>
      <path d="M42 50c0 6 4 8 8 8s6-3 6-8" fill="#FBF3DC" stroke="#382C23" stroke-width="3.5" stroke-linejoin="round"/>
      <path d="M14 24h7M17.5 24v8M23 28a3.5 4 0 1 0 7 0 3.5 4 0 1 0-7 0M33 24v8h1.5a3.5 4 0 0 0 0-8zM41 28a3.5 4 0 1 0 7 0 3.5 4 0 1 0-7 0"
            fill="none" stroke="#382C23" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>
      <path d="M22 39h20M26 44h12" stroke="#382C23" stroke-width="3" stroke-linecap="round"/>
      <path d="M28 6l7 7" stroke="#382C23" stroke-width="3.5" stroke-linecap="round"/>
      <circle cx="26" cy="5" r="5" fill="#9C5D3C" stroke="#382C23" stroke-width="3"/>
    </svg>
    <span class="sr-only"><%= chat_task ? "Mudar esta tarefa pelo chat" : "Adicionar tarefa ou evento" %></span>
  </button>
</div>
