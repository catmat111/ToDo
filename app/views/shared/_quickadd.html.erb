<%# Floating "post-it" button (bottom-right) that opens a small chat to add tasks for today. %>
<div class="quickadd" data-controller="quickadd" data-action="keydown.esc@window->quickadd#close">
  <section class="quickadd__panel" id="quickadd-panel" role="dialog" aria-modal="false"
           aria-labelledby="quickadd-title" data-quickadd-target="panel" hidden>
    <header class="quickadd__header">
      <p class="quickadd__title" id="quickadd-title">Para hoje</p>
      <button type="button" class="quickadd__close" data-action="quickadd#close" aria-label="Fechar">×</button>
    </header>

    <div class="quickadd__messages" id="quickadd_messages" data-quickadd-target="messages" aria-live="polite">
      <div class="quickadd__msg quickadd__msg--app">
        Olá<%= ", #{Current.user.first_name}" if Current.user.first_name %>! O que tens de fazer hoje?
      </div>
    </div>

    <%= form_with url: tasks_path, scope: :task, class: "quickadd__form",
          data: { action: "turbo:submit-end->quickadd#sent" } do |f| %>
      <%= hidden_field_tag :return_to, "chat", id: nil %>
      <%# End of today = "today", no specific hour (see ApplicationHelper#all_day?). %>
      <%= f.hidden_field :due_at, value: Time.current.end_of_day.strftime("%Y-%m-%dT%H:%M"), id: nil %>
      <%= f.label :title, "Nova tarefa para hoje", class: "sr-only", for: "quickadd-input" %>
      <%= f.text_field :title, id: "quickadd-input", placeholder: "Ex.: Ligar ao banco", required: true,
            maxlength: 200, autocomplete: "off", data: { quickadd_target: "input" } %>
      <button type="submit" class="quickadd__send" aria-label="Adicionar">➤</button>
    <% end %>
  </section>

  <button type="button" class="quickadd__fab" data-action="quickadd#toggle" data-quickadd-target="toggle"
          aria-controls="quickadd-panel" aria-expanded="false" title="Adicionar tarefa para hoje">
    <svg viewBox="-2 -4 70 70" width="96" height="96" aria-hidden="true">
      <path d="M8 10h48v40H8z" fill="#FBF3DC" stroke="#382C23" stroke-width="3.5" stroke-linejoin="round"/>
      <path d="M4 50h38c0 6 4 8 8 8H10c-3 0-6-3-6-8z" fill="#E9C46A" stroke="#382C23" stroke-width="3.5" stroke-linejoin="round"/>
      <path d="M42 50c0 6 4 8 8 8s6-3 6-8" fill="#FBF3DC" stroke="#382C23" stroke-width="3.5" stroke-linejoin="round"/>
      <path d="M14 24h7M17.5 24v8M23 28a3.5 4 0 1 0 7 0 3.5 4 0 1 0-7 0M33 24v8h1.5a3.5 4 0 0 0 0-8zM41 28a3.5 4 0 1 0 7 0 3.5 4 0 1 0-7 0"
            fill="none" stroke="#382C23" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>
      <path d="M22 39h20M26 44h12" stroke="#382C23" stroke-width="3" stroke-linecap="round"/>
      <path d="M28 6l7 7" stroke="#382C23" stroke-width="3.5" stroke-linecap="round"/>
      <circle cx="26" cy="5" r="5" fill="#9C5D3C" stroke="#382C23" stroke-width="3"/>
    </svg>
    <span class="sr-only">Adicionar tarefa para hoje</span>
  </button>
</div>
