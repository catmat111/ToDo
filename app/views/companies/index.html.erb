<% content_for :title, "Empresas" %>

<div class="page-header">
  <div>
    <h1 class="page-header__title">Empresas</h1>
  </div>
  <div class="page-header__actions">
    <%= link_to contacts_path, class: "btn btn--outline" do %><%= icon :user %> Contactos<% end %>
    <%= link_to new_company_path, class: "btn btn--primary" do %><%= icon :plus %> Nova empresa<% end %>
  </div>
</div>

<%= form_with url: companies_path, method: :get, class: "companies-toolbar" do |f| %>
  <%= f.hidden_field :sort, value: @sort, id: nil %>
  <%= f.label :q, "Pesquisar empresa", class: "sr-only" %>
  <%= f.search_field :q, value: params[:q], class: "input", placeholder: "Pesquisar empresa…" %>
  <%= f.button icon(:search), class: "btn btn--outline", name: nil, "aria-label": "Pesquisar" %>
  <nav class="companies-sort" aria-label="Ordenar">
    <%= link_to "Mais candidaturas", companies_path(q: params[:q].presence, sort: "applications"),
          class: "btn btn--sm #{@sort == 'applications' ? 'btn--secondary' : 'btn--ghost'}",
          "aria-current": (@sort == "applications" ? "true" : nil) %>
    <%= link_to "A–Z", companies_path(q: params[:q].presence, sort: "name"),
          class: "btn btn--sm #{@sort == 'name' ? 'btn--secondary' : 'btn--ghost'}",
          "aria-current": (@sort == "name" ? "true" : nil) %>
  </nav>
<% end %>

<% if @companies.any? %>
  <% max = [ @companies.map { |c| c.applications_count.to_i }.max, 1 ].max %>
  <div class="card card--flush">
    <ul class="list">
      <% @companies.each do |company| %>
        <% count = company.applications_count.to_i %>
        <li class="list__item company-row">
          <div class="list__main">
            <%= link_to company.name, company, class: "list__title" %>
            <% if company.location.present? %><div class="list__meta"><span><%= company.location %></span></div><% end %>
          </div>
          <div class="company-row__count" title="<%= pluralize(count, "candidatura", plural: "candidaturas") %>">
            <span class="company-row__bar" aria-hidden="true"><span style="width: <%= (count * 100.0 / max).round %>%"></span></span>
            <strong><%= count %></strong>
          </div>
        </li>
      <% end %>
    </ul>
  </div>
<% else %>
  <%= render "shared/empty_state", title: "Sem empresas",
        action: link_to("Nova empresa", new_company_path, class: "btn btn--primary") %>
<% end %>
