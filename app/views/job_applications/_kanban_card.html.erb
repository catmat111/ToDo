<%# locals: (job_application:, next_task: nil) %>
<article class="kanban__card ja-card"
         id="<%= dom_id(job_application, :card) %>"
         <% unless job_application.closed? %>draggable="true"<% end %>
         data-application-kanban-target="card"
         data-status="<%= job_application.status %>"
         data-allowed="<%= job_application.allowed_transitions.join(' ') %>"
         data-url="<%= transition_job_application_path(job_application) %>"
         data-title="<%= job_application.title %>">
  <%= link_to job_application.title, job_application, class: "ja-card__title" %>
  <% if job_application.company_name.present? %>
    <p class="ja-card__company"><%= icon :briefcase, size: 14 %> <%= job_application.company_name %></p>
  <% end %>
  <p class="ja-card__meta"><%= icon :clock, size: 14 %> <%= job_application_activity(job_application) %></p>
  <% if next_task %>
    <p class="ja-card__task <%= 'ja-card__task--overdue' if next_task.overdue? %>">
      <%= icon :tasks, size: 14 %>
      <span><span class="sr-only">Próxima tarefa:</span> <%= next_task.title.truncate(48) %> · <%= relative_due(next_task.due_at) %></span>
    </p>
  <% end %>
</article>
