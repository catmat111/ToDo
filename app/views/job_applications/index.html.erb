<% content_for :title, "Candidaturas" %>
<% total = @status_counts.values.sum %>
<% in_progress = @status_counts.slice("saved", "applied", "interview", "offer").values.sum %>

<div class="page-header">
  <div>
    <h1 class="page-header__title">Candidaturas</h1>
    <p class="page-header__subtitle">
      <% if total.zero? %>
        Acompanha cada candidatura desde que guardas a vaga até à resposta final.
      <% else %>
        <%= total == 1 ? "1 candidatura" : "#{total} candidaturas" %> · <%= in_progress %> em curso
      <% end %>
    </p>
  </div>
  <div class="page-header__actions">
    <%= link_to new_linkedin_import_path, class: "btn btn--ghost" do %><%= icon :refresh %> Importar do LinkedIn<% end %>
    <%= link_to new_job_application_path, class: "btn btn--primary" do %><%= icon :plus %> Nova candidatura<% end %>
  </div>
</div>

<% if total.zero? %>
  <%= render "shared/empty_state",
        title: "Ainda não tens candidaturas",
        body: "Guarda uma vaga que te interesse ou regista uma candidatura manualmente. Depois é só acompanhar cada etapa.",
        action: link_to("Criar a primeira candidatura", new_job_application_path, class: "btn btn--primary") %>
<% else %>
  <%# Toolbar: view tabs on the left, search on the right; the rarer filters fold away. %>
  <% active_filters = [ @status.presence, @work_mode, @min_salary, params[:sort].presence ].compact.size %>
  <% more_filters = active_filters.positive? %>
  <div class="ja-toolbar">
    <nav class="tabs ja-toolbar__tabs" aria-label="Modo de visualização">
      <%= link_to job_application_view_path("kanban"), class: [ "tabs__link", ("is-active" if @view == "kanban") ],
            "aria-current": (@view == "kanban" ? "page" : nil) do %>Quadro<% end %>
      <%= link_to job_application_view_path("list"), class: [ "tabs__link", ("is-active" if @view == "list") ],
            "aria-current": (@view == "list" ? "page" : nil) do %>Lista<% end %>
    </nav>

    <%= form_with url: job_applications_path, method: :get, class: "ja-toolbar__search", role: "search" do |f| %>
      <%= hidden_field_tag :view, @view, id: nil %>
      <%= f.search_field :q, value: @query, placeholder: "Título ou empresa…", class: "input", "aria-label": "Pesquisar candidaturas" %>
      <details class="ja-toolbar__more">
        <summary class="btn btn--ghost btn--sm">Mais filtros<% if more_filters %> <span class="badge"><%= active_filters %></span><% end %></summary>
        <div class="filters ja-toolbar__panel">
          <% if @view == "list" %>
            <div class="field">
              <%= f.label :status, "Estado", class: "field__label" %>
              <%= f.select :status, job_application_status_options(@status), {}, class: "input" %>
            </div>
            <div class="field">
              <%= f.label :sort, "Ordenar", class: "field__label" %>
              <%= f.select :sort, options_for_select([ [ "Mais recentes", "" ], [ "Maior salário", "salary" ] ], params[:sort]), {}, class: "input" %>
            </div>
          <% end %>
          <%= render "shared/compensation_filters", f: f %>
        </div>
      </details>
      <%= f.button class: "btn btn--secondary btn--sm", "aria-label": "Filtrar" do %><%= icon :search, size: 14 %><% end %>
      <% if @query.present? || more_filters %>
        <%= link_to "Limpar", job_applications_path(view: @view), class: "btn btn--ghost btn--sm" %>
      <% end %>
    <% end %>
  </div>

  <% if @view == "list" %>
    <%= render "list", job_applications: @job_applications, next_tasks: @next_tasks %>
  <% else %>
    <%= render "kanban", columns: @columns, next_tasks: @next_tasks %>
  <% end %>
<% end %>
