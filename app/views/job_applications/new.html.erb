<% content_for :title, "Nova candidatura" %>

<div class="page-header">
  <div>
    <nav class="breadcrumb" aria-label="Navegação estrutural">
      <%= link_to "Candidaturas", job_applications_path %> / <span aria-current="page">Nova</span>
    </nav>
    <h1 class="page-header__title">Nova candidatura</h1>
    <p class="page-header__subtitle">
      <% if @job_listing %>
        Regista a tua candidatura a esta vaga e acompanha cada etapa.
      <% else %>
        Regista uma candidatura manualmente ou <%= link_to "escolhe uma vaga guardada", job_listings_path %>.
      <% end %>
    </p>
  </div>
</div>

<div class="card ja-form-card">
  <%= render "form", job_application: @job_application %>
</div>
