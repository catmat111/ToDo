<% content_for :title, "Hoje" %>
<% today_list = @dashboard.today_tasks %>
<% upcoming = @dashboard.upcoming_by_day %>
<% open_applications = @dashboard.open_applications_count %>
<% progress = @dashboard.today_progress %>
<% now = @dashboard.now %>

<div class="home home--<%= @dashboard.time_of_day %>">
  <%# Header: a little landscape whose sky follows the clock — dawn, day, dusk, night —
      with the sun (or moon) along its arc; sky_controller.js keeps it moving. %>
  <% sky = @dashboard.sky %>
  <header class="home-hero" data-controller="sky" data-sky="<%= sky[:phase] %>" style="--sky-t: <%= sky[:progress] / 100.0 %>">
    <div class="home-sky" aria-hidden="true">
      <span class="home-sky__glow"></span>
      <span class="home-sky__orb"></span>
      <svg class="home-sky__stars" viewBox="0 0 400 120" preserveAspectRatio="none">
        <% [ [ 30, 18 ], [ 70, 52 ], [ 120, 24 ], [ 160, 70 ], [ 205, 14 ], [ 250, 46 ], [ 290, 22 ], [ 330, 60 ], [ 370, 30 ], [ 95, 88 ], [ 230, 92 ], [ 355, 84 ] ].each_with_index do |(x, y), i| %>
          <circle cx="<%= x %>" cy="<%= y %>" r="<%= i.even? ? 1.3 : 0.9 %>" style="animation-delay: <%= (i * 0.37).round(2) %>s"/>
        <% end %>
      </svg>
      <svg class="home-sky__clouds" viewBox="0 0 400 120" preserveAspectRatio="none">
        <path d="M40 40a12 12 0 0 1 22-6 10 10 0 0 1 18 6h4a6 6 0 0 1 0 12H40a6 6 0 0 1 0-12z"/>
        <path d="M250 26a10 10 0 0 1 18-5 8 8 0 0 1 15 5h3a5 5 0 0 1 0 10h-36a5 5 0 0 1 0-10z"/>
      </svg>
      <svg class="home-sky__hills" viewBox="0 0 400 60" preserveAspectRatio="none">
        <path class="home-sky__hill home-sky__hill--far" d="M0 38 C60 18 110 30 160 26 S260 8 320 22 S380 30 400 24 V60 H0z"/>
        <path class="home-sky__hill home-sky__hill--near" d="M0 50 C70 34 120 46 190 40 S300 30 360 42 S395 46 400 44 V60 H0z"/>
      </svg>
    </div>

    <div class="home-hero__text">
      <p class="home-hero__date"><%= @dashboard.today_label %></p>
      <h1 class="home-hero__greeting home__greeting"><%= @dashboard.greeting %><span class="wordmark__dot">.</span></h1>
      <p class="home-hero__mood"><%= @dashboard.mood %></p>
      <% if (objective = Current.user.objective.presence) %>
        <p class="home__objective">
          <span class="sr-only">O teu objetivo:</span><%= link_to objective.truncate(140), profile_path, title: "O teu objetivo — editar no perfil" %>
        </p>
      <% end %>
    </div>

    <% if progress %>
      <div class="home-ring" style="--p: <%= progress %>" role="img"
           aria-label="<%= @dashboard.completed_today_count %> de <%= @dashboard.completed_today_count + today_list.size %> tarefas de hoje feitas">
        <span class="home-ring__value"><%= @dashboard.completed_today_count %><small>/<%= @dashboard.completed_today_count + today_list.size %></small></span>
        <span class="home-ring__label">feitas hoje</span>
      </div>
    <% end %>
  </header>

  <%# Two columns: the backlog by tag on the left, today and next on the right
      (on phones the backlog goes below). %>
  <%# Tasks can be dragged between the backlog and today (home_drag_controller.js). %>
  <div class="home__layout" data-controller="home-drag"
       data-action="dragstart->home-drag#start dragend->home-drag#end dragover->home-drag#over dragleave->home-drag#leave drop->home-drag#drop">
    <div class="home__main">
      <section class="home__section home__section--today home-notepad" aria-labelledby="home-today" data-drop-zone="today">
        <h2 class="home__heading" id="home-today">Hoje <span class="home__count"><%= today_list.size %></span></h2>
        <ul class="home__list" id="home-today-list">
          <%= render partial: "dashboard/task", collection: today_list, as: :task %>
        </ul>
        <div class="home__empty">
          <svg class="home__cup" viewBox="0 0 64 64" width="64" height="64" aria-hidden="true">
            <path class="home__steam" d="M24 6c-3 4 3 6 0 10M32 4c-3 4 3 6 0 10M40 6c-3 4 3 6 0 10" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
            <path d="M12 24h36v14a16 16 0 0 1-16 16h-4a16 16 0 0 1-16-16z" fill="var(--color-surface)" stroke="currentColor" stroke-width="3" stroke-linejoin="round"/>
            <path d="M48 28h3a7 7 0 0 1 0 14h-4" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"/>
            <path d="M8 58h44" stroke="currentColor" stroke-width="3" stroke-linecap="round"/>
          </svg>
          <p>Nada para hoje. Aproveita — ou adiciona algo no post-it.</p>
        </div>
      </section>

      <% if upcoming.any? %>
        <section class="home__section home__section--next" aria-labelledby="home-next">
          <h2 class="home__heading" id="home-next">A seguir</h2>
          <% upcoming.each do |date, tasks| %>
            <h3 class="home__day"><%= date == now.to_date + 1 ? "Amanhã" : l(date, format: "%A, %-d").upcase_first %></h3>
            <ul class="home__list">
              <%= render partial: "dashboard/task", collection: tasks, as: :task %>
            </ul>
          <% end %>
          <%= link_to "Ver todas as tarefas →", tasks_path, class: "home__more" %>
        </section>
      <% end %>

      <% if open_applications.positive? %>
        <p class="home__footnote">
          <%= link_to job_applications_path do %>
            <%= icon :briefcase, size: 16 %>
            <%= pluralize(open_applications, "candidatura em curso", plural: "candidaturas em curso") %> →
          <% end %>
        </p>
      <% end %>
    </div>

    <%= render "dashboard/backlog", groups: @dashboard.backlog %>
  </div>
</div>
