<%# locals: (task:) %>
<li class="home-task<%= " home-task--overdue" if task.overdue? %>">
  <%= button_to complete_task_path(task), method: :patch, class: "home-task__check",
        title: "Marcar como concluída", "aria-label": "Marcar “#{task.title}” como concluída" do %>
    <%= icon :check, size: 16 %>
  <% end %>
  <%= link_to task.title, task_path(task), class: "home-task__title" %>
  <% if task.blocked? %><span class="badge badge--overdue" title="À espera de outra tarefa">bloqueada</span><% end %>
  <span class="home-task__due"><%= task.overdue? ? "atrasada" : relative_due(task.due_at) %></span>
</li>
