<%# locals: (task:, show_progress: false) %>
<li class="list__item dashboard-task<%= " dashboard-task--overdue" if task.overdue? %>">
  <%= button_to complete_task_path(task), method: :patch, class: "dashboard-task__check",
        title: "Marcar como concluída", "aria-label": "Marcar “#{task.title}” como concluída" do %>
    <%= icon :check, size: 14 %>
  <% end %>
  <div class="list__main">
    <%= link_to task.title, task_path(task), class: "list__title" %>
    <div class="list__meta">
      <span class="dashboard-task__due"><%= icon :clock, size: 14 %> <%= dashboard_due_label(task) %></span>
      <%= priority_badge(task) %>
      <% task.tags.first(3).each do |tag_record| %>
        <%= tag_chip(tag_record) %>
      <% end %>
    </div>
    <% if show_progress %>
      <div class="dashboard-task__progress">
        <%= progress_bar(task.progress_percent, label: "Progresso de #{task.title}") %>
        <span class="small muted"><%= subtask_summary(task) || "Sem subtarefas" %> · <%= task.progress_percent %>%</span>
      </div>
    <% end %>
  </div>
</li>
