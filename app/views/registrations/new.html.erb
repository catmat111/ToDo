<% content_for :title, "Criar conta" %>
<div data-controller="theme" data-theme-name-value="<%= theme_attribute %>" hidden></div>

<div class="auth-intro">
  <h2 class="auth-intro__title">Criar conta</h2>
  <p class="auth-intro__text">Organiza tarefas, candidaturas e o teu calendário num só sítio.</p>
</div>

<%= form_with model: @user, url: registration_path, class: "form", data: { turbo: false } do |form| %>
  <%= render "shared/form_errors", record: @user %>

  <div class="field">
    <%= form.label :name, "Nome", class: "field__label" %>
    <%= form.text_field :name, required: true, autofocus: true, autocomplete: "name", maxlength: 100,
                        placeholder: "Como te chamas?" %>
  </div>

  <div class="field">
    <%= form.label :email_address, "Email", class: "field__label" %>
    <%= form.email_field :email_address, required: true, autocomplete: "email", placeholder: "nome@exemplo.pt" %>
  </div>

  <div class="field">
    <%= form.label :password, "Password", class: "field__label" %>
    <%= form.password_field :password, required: true, autocomplete: "new-password", minlength: 8, maxlength: 72,
                            "aria-describedby": "password-hint" %>
    <p class="field__hint" id="password-hint">Pelo menos 8 caracteres.</p>
  </div>

  <div class="field">
    <%= form.label :password_confirmation, "Confirmar password", class: "field__label" %>
    <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72 %>
  </div>

  <div class="field">
    <%= form.label :timezone, "Fuso horário", class: "field__label" %>
    <%= form.select :timezone, timezone_options, {}, "aria-describedby": "timezone-hint" %>
    <p class="field__hint" id="timezone-hint">Usado para prazos, lembretes e o calendário. Podes mudar depois.</p>
  </div>

  <%= form.submit "Criar conta", class: "btn btn--primary btn--block" %>
<% end %>

<p class="auth__footer">
  Já tens conta? <%= link_to "Entrar", new_session_path %>
</p>
