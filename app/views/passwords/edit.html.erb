<% content_for :title, "Nova password" %>
<div data-controller="theme" data-theme-name-value="<%= theme_attribute %>" hidden></div>

<div class="auth-intro">
  <h2 class="auth-intro__title">Nova password</h2>
  <p class="auth-intro__text">Escolhe uma nova password. Por segurança, todas as sessões abertas serão terminadas.</p>
</div>

<%= form_with url: password_path(params[:token]), method: :put, class: "form" do |form| %>
  <%= render "shared/form_errors", record: @user %>

  <div class="field">
    <%= form.label :password, "Nova password", class: "field__label" %>
    <%= form.password_field :password, required: true, autofocus: true, autocomplete: "new-password",
                            minlength: 8, maxlength: 72, "aria-describedby": "password-hint" %>
    <p class="field__hint" id="password-hint">Pelo menos 8 caracteres.</p>
  </div>

  <div class="field">
    <%= form.label :password_confirmation, "Confirmar nova password", class: "field__label" %>
    <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72 %>
  </div>

  <%= form.submit "Guardar nova password", class: "btn btn--primary btn--block" %>
<% end %>

<p class="auth__footer">
  <%= link_to "Voltar a entrar", new_session_path %>
</p>
