<%# locals: (shareable:) %>
<section class="card" aria-labelledby="share-title-<%= dom_id(shareable) %>">
  <details class="disclosure">
    <summary class="disclosure__title" id="share-title-<%= dom_id(shareable) %>">
      <span class="card__title">Partilhar</span>
      <span class="btn btn--ghost btn--sm"><%= icon :user, size: 16 %> Convidar</span>
    </summary>
    <%= form_with scope: :share, url: shares_path, class: "form disclosure__body" do |f| %>
      <%= f.hidden_field :shareable_type, value: shareable.class.name %>
      <%= f.hidden_field :shareable_id, value: shareable.id %>
      <div class="field">
        <%= f.email_field :email, required: true, autocomplete: "off", placeholder: "Email da pessoa", "aria-label": "Email da pessoa" %>
      </div>
      <div class="field">
        <%= f.text_area :message, rows: 2, maxlength: 1000, placeholder: "Mensagem (opcional)", "aria-label": "Mensagem" %>
      </div>
      <div class="form__actions">
        <%= f.button type: "submit", class: "btn btn--secondary btn--sm" do %><%= icon :check, size: 16 %> Enviar<% end %>
      </div>
    <% end %>
  </details>
</section>
