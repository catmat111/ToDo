<% content_for :title, "Alterar password" %>

<div class="page-header">
  <div>
    <nav class="breadcrumb" aria-label="Caminho"><%= link_to "Perfil", profile_path %> / Password</nav>
    <h1 class="page-header__title">Alterar password</h1>
    <p class="page-header__subtitle">Por segurança, as sessões abertas noutros dispositivos serão terminadas.</p>
  </div>
</div>

<div class="card profile-form profile-form--narrow">
  <%= form_with model: @user, url: password_profile_path, method: :patch, class: "form" do |form| %>
    <%= render "shared/form_errors", record: @user %>

    <div class="field">
      <%= form.label :current_password, "Password atual", class: "field__label" %>
      <%= form.password_field :current_password, required: true, autofocus: true,
                              autocomplete: "current-password", maxlength: 72 %>
    </div>

    <div class="field">
      <%= form.label :password, "Nova password", class: "field__label" %>
      <%= form.password_field :password, required: true, autocomplete: "new-password", minlength: 8, maxlength: 72,
                              "aria-describedby": "new-password-hint" %>
      <p class="field__hint" id="new-password-hint">Pelo menos 8 caracteres.</p>
    </div>

    <div class="field">
      <%= form.label :password_confirmation, "Confirmar nova password", class: "field__label" %>
      <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72 %>
    </div>

    <div class="form__actions">
      <%= form.submit "Alterar password", class: "btn btn--primary" %>
      <%= link_to "Cancelar", profile_path, class: "btn btn--ghost" %>
    </div>
  <% end %>
</div>
