<% content_for :title, "Editar perfil" %>

<div class="page-header">
  <div>
    <nav class="breadcrumb" aria-label="Caminho"><%= link_to "Perfil", profile_path %> / Editar</nav>
    <h1 class="page-header__title">Editar perfil</h1>
    <p class="page-header__subtitle">Atualiza os teus dados e a forma como a app se apresenta.</p>
  </div>
</div>

<div class="card profile-form">
  <%# Full page load so a theme change is applied to <html> straight away. %>
  <%= form_with model: @user, url: profile_path, method: :patch, class: "form", data: { turbo: false } do |form| %>
    <%= render "shared/form_errors", record: @user %>

    <fieldset class="form__section">
      <legend>Dados pessoais</legend>
      <div class="stack">
        <div class="form__row">
          <div class="field">
            <%= form.label :name, "Nome", class: "field__label" %>
            <%= form.text_field :name, required: true, maxlength: 100, autocomplete: "name" %>
          </div>
          <div class="field">
            <%= form.label :email_address, "Email", class: "field__label" %>
            <%= form.email_field :email_address, required: true, autocomplete: "email" %>
          </div>
          <div class="field">
            <%= label_tag :current_password, "Password atual", class: "field__label" %>
            <%= password_field_tag :current_password, nil, autocomplete: "current-password", "aria-describedby": "current-password-hint" %>
            <p class="field__hint" id="current-password-hint">Só é necessária se mudares o email.</p>
          </div>
        </div>

        <div class="field">
          <span class="field__label">Fotografia de perfil</span>
          <div class="avatar-field">
            <%= render "profiles/avatar_picker", form: form, user: @user %>
            <div class="stack--sm">
              <% if @user.avatar.attached? %>
                <label class="check"><%= check_box_tag :remove_avatar, "1", false %> Remover fotografia atual</label>
              <% end %>
            </div>
          </div>
          <p class="field__hint" id="avatar-hint">PNG, JPG, WebP ou GIF, até 5 MB. Sem fotografia, mostramos a tua inicial.</p>
        </div>

        <div class="field">
          <%= form.label :avatar_url, "Ou um link para uma fotografia", class: "field__label" %>
          <div data-controller="avatar-url-preview">
            <%= form.url_field :avatar_url, placeholder: "https://…", maxlength: 2000, "aria-describedby": "avatar-url-hint",
                  data: { avatar_url_preview_target: "input", action: "keydown.enter->avatar-url-preview#preview:prevent change->avatar-url-preview#preview" } %>
            <p class="field__hint" id="avatar-url-hint" data-avatar-url-preview-target="status">Carrega Enter para pré-visualizar. Funciona com links diretos para imagens e links do Giphy.</p>
          </div>
        </div>

        <div class="field">
          <%= form.label :objective, "Objetivo", class: "field__label" %>
          <%= form.text_area :objective, rows: 4, maxlength: 2000, "aria-describedby": "objective-hint",
                             placeholder: "Ex.: Encontrar um estágio em desenvolvimento web até ao verão." %>
          <p class="field__hint" id="objective-hint">Aparece no teu perfil como lembrete do que queres alcançar.</p>
        </div>
      </div>
    </fieldset>

    <hr>

    <fieldset class="form__section">
      <legend>Preferências</legend>
      <div class="form__row">
        <div class="field">
          <%= form.label :theme, "Tema", class: "field__label" %>
          <%= form.select :theme, theme_options %>
        </div>
        <div class="field">
          <%= form.label :timezone, "Fuso horário", class: "field__label" %>
          <%= form.select :timezone, timezone_options, {}, "aria-describedby": "timezone-hint" %>
          <p class="field__hint" id="timezone-hint">As datas, prazos e lembretes são mostrados neste fuso.</p>
        </div>
        <div class="field">
          <%= form.label :follow_up_after_days, "Lembrete de follow-up (dias)", class: "field__label" %>
          <%= form.number_field :follow_up_after_days, min: 0, max: 90, step: 1, "aria-describedby": "follow-up-hint" %>
          <p class="field__hint" id="follow-up-hint">Se uma candidatura enviada ficar estes dias sem novidades, crio uma tarefa de follow-up. 0 desliga.</p>
        </div>
        <div class="field">
          <%= form.label :linkedin_app, "App do LinkedIn", class: "field__label" %>
          <%= form.select :linkedin_app, [ [ "Perguntar quando abrir uma pesquisa", "" ], [ "Tenho a app (abrir na app)", "true" ], [ "Não tenho (abrir no browser)", "false" ] ],
                          { selected: @user.linkedin_app.nil? ? "" : @user.linkedin_app.to_s }, "aria-describedby": "linkedin-app-hint" %>
          <p class="field__hint" id="linkedin-app-hint">Define onde abrem as pesquisas do LinkedIn.</p>
        </div>
      </div>
    </fieldset>

    <div class="form__actions">
      <%= form.submit "Guardar alterações", class: "btn btn--primary" %>
      <%= link_to "Cancelar", profile_path, class: "btn btn--ghost" %>
    </div>
  <% end %>
</div>
