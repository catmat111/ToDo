<div style="background:#F3EEE5;padding:32px 16px;font-family:Helvetica,Arial,sans-serif;color:#382C23;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:560px;margin:0 auto;background:#FBF8F3;border:1px solid #D1C7B5;border-radius:14px;">
    <tr>
<td style="background:#9B4922;border-radius:14px 14px 0 0;padding:18px 28px;">
  <span style="color:#EFE7DD;font-family:Georgia,'Times New Roman',serif;font-size:26px;font-weight:600;letter-spacing:-0.01em;">Tu Do.</span>
</td>
    </tr>
    <tr>
      <td style="padding:28px;">
        <p style="margin:0 0 6px;font-size:13px;letter-spacing:0.08em;text-transform:uppercase;color:#B07E1E;font-weight:bold;">Lembrete</p>
        <h1 style="margin:0 0 16px;font-family:Georgia,serif;font-size:26px;line-height:1.25;color:#382C23;"><%= @task&.title || @notification.title %></h1>
        <p style="margin:0 0 16px;font-size:15px;line-height:1.6;">Olá <%= @user.first_name %>,</p>
        <% if @notification.body.present? %>
          <p style="margin:0 0 16px;font-size:15px;line-height:1.6;"><%= @notification.body %></p>
        <% end %>
        <% if @task %>
          <table role="presentation" cellpadding="0" cellspacing="0" style="width:100%;margin:0 0 24px;background:#EDE6DA;border-left:4px solid #9C5D3C;border-radius:8px;">
            <tr>
              <td style="padding:14px 18px;font-size:14px;line-height:1.6;">
                <strong>Prazo:</strong> <%= @task.due_at ? l(@task.due_at.in_time_zone, format: "%d/%m/%Y às %H:%M") : "sem prazo" %><br>
                <strong>Prioridade:</strong> <%= @task.priority_label.capitalize %>
              </td>
            </tr>
          </table>
          <a href="<%= task_url(@task) %>" style="display:inline-block;background:#9C5D3C;color:#FBF8F3;text-decoration:none;padding:12px 22px;border-radius:999px;font-weight:bold;font-size:15px;">Abrir tarefa</a>
        <% else %>
          <a href="<%= notifications_url %>" style="display:inline-block;background:#9C5D3C;color:#FBF8F3;text-decoration:none;padding:12px 22px;border-radius:999px;font-weight:bold;font-size:15px;">Ver notificações</a>
        <% end %>
      </td>
    </tr>
    <tr>
      <td style="padding:16px 28px;border-top:1px solid #D1C7B5;font-size:12px;color:#6E6B41;">
        Recebeste este email porque criaste um lembrete por email no Tu Do.
      </td>
    </tr>
  </table>
</div>
